// ResiControl - modelo de datos.
// El centro es RegistroEjecucion (un dia de trabajo). Los indicadores no se
// guardan: se calculan en lib/calculos.ts.

generator client {
  provider = "prisma-client-js"
}

/// url: endpoint con pool (PgBouncer) para la app; evita conexiones cerradas
/// cuando Neon se suspende. directUrl: endpoint directo para migraciones.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Enumeraciones ---

/// ADMIN: todo. RESIDENTE: gestiona obra y registra. SUPERVISOR: solo consulta.
enum RolUsuario {
  ADMIN
  RESIDENTE
  SUPERVISOR
}

enum EstadoProyecto {
  PLANEACION
  EN_EJECUCION
  SUSPENDIDO
  FINALIZADO
}

/// Como se eligio el periodo de una liquidacion (las fechas son las que mandan).
enum PeriodoLiquidacion {
  MES
  QUINCENA
  RANGO
}

/// Estado de avance de una torre o de un elemento.
enum EstadoEjecucion {
  PENDIENTE
  EN_PROCESO
  TERMINADO
  SUSPENDIDO
}

// --- Usuarios del sistema (distinto de Trabajador) ---

model Usuario {
  id           Int        @id @default(autoincrement()) @map("id_usuario")
  nombre       String     @db.VarChar(100)
  apellido     String     @db.VarChar(100)
  email        String     @unique @db.VarChar(150)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  rol          RolUsuario @default(RESIDENTE)
  activo       Boolean    @default(true)

  /// Intentos fallidos seguidos y fin del bloqueo. Se reinician al entrar bien.
  intentosFallidos Int       @default(0) @map("intentos_fallidos")
  bloqueadoHasta   DateTime? @map("bloqueado_hasta")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  registrosCreados      RegistroEjecucion[] @relation("RegistroCreadoPor")
  registrosActualizados RegistroEjecucion[] @relation("RegistroActualizadoPor")
  tareasAsignadas       Tarea[]             @relation("TareaAsignadaPor")
  liquidacionesHechas   Liquidacion[]       @relation("LiquidacionHechaPor")

  @@map("usuarios")
}

// --- Jerarquia de la obra: Proyecto > Torre > Piso > Zona > Elemento ---

model Proyecto {
  id          Int            @id @default(autoincrement()) @map("id_proyecto")
  codigo      String         @unique @db.VarChar(50)
  nombre      String         @db.VarChar(150)
  descripcion String?        @db.Text
  fechaInicio DateTime?      @map("fecha_inicio") @db.Date
  fechaFin    DateTime?      @map("fecha_fin") @db.Date
  estado      EstadoProyecto @default(PLANEACION)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  torres     Torre[]
  cuadrillas Cuadrilla[]
  metas      Meta[]

  @@map("proyectos")
}

model Torre {
  id          Int             @id @default(autoincrement()) @map("id_torre")
  proyectoId  Int             @map("id_proyecto")
  codigo      String          @db.VarChar(20)
  nombre      String          @db.VarChar(50)
  descripcion String?         @db.VarChar(255)
  estado      EstadoEjecucion @default(PENDIENTE)

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  pisos    Piso[]

  @@unique([proyectoId, codigo])
  @@index([proyectoId])
  @@map("torres")
}

model Piso {
  id          Int     @id @default(autoincrement()) @map("id_piso")
  torreId     Int     @map("id_torre")
  numero      Int
  nombre      String? @db.VarChar(50)
  descripcion String? @db.VarChar(255)

  torre Torre  @relation(fields: [torreId], references: [id], onDelete: Cascade)
  zonas Zona[]

  @@unique([torreId, numero])
  @@index([torreId])
  @@map("pisos")
}

/// Apartamento, area o zona de trabajo dentro de un piso.
model Zona {
  id          Int     @id @default(autoincrement()) @map("id_zona")
  pisoId      Int     @map("id_piso")
  codigo      String  @db.VarChar(50)
  nombre      String  @db.VarChar(100)
  tipo        String? @db.VarChar(50)
  descripcion String? @db.VarChar(255)

  piso    Piso            @relation(fields: [pisoId], references: [id], onDelete: Cascade)
  elementos ElementoConstructivo[]

  @@unique([pisoId, codigo])
  @@index([pisoId])
  @@map("zonas")
}

/// Elemento sobre el que se ejecuta una actividad (muro, losa...).
/// codigoDwg se puede repetir en distintas zonas.
model ElementoConstructivo {
  id          Int             @id @default(autoincrement()) @map("id_elemento")
  zonaId      Int             @map("id_zona")
  codigoDwg   String          @map("codigo_dwg") @db.VarChar(50)
  descripcion String          @db.VarChar(150)
  unidad      String?         @db.VarChar(20)
  estado      EstadoEjecucion @default(PENDIENTE)

  /// Medidas del elemento. La tarea y el registro de obra las toman de aqui;
  /// el registro guarda una copia.
  largo Decimal @db.Decimal(10, 2)
  alto  Decimal @db.Decimal(10, 2)

  /// Suma del area de sus vanos. Se recalcula cada vez que se guarda el elemento.
  areaVanos Decimal @default(0) @map("area_vanos") @db.Decimal(12, 2)

  zona      Zona                @relation(fields: [zonaId], references: [id], onDelete: Cascade)
  vanos     Vano[]
  registros RegistroEjecucion[]
  tareas    Tarea[]

  @@unique([zonaId, codigoDwg, descripcion])
  @@index([zonaId])
  @@index([codigoDwg])
  @@map("elementos_constructivos")
}

/// Hueco de un elemento (ventana, puerta...). Su area se resta de la del muro.
model Vano {
  id          Int     @id @default(autoincrement()) @map("id_vano")
  elementoId  Int     @map("id_elemento")
  descripcion String? @db.VarChar(100)
  largo       Decimal @db.Decimal(10, 2)
  ancho       Decimal @db.Decimal(10, 2)

  elemento ElementoConstructivo @relation(fields: [elementoId], references: [id], onDelete: Cascade)

  @@index([elementoId])
  @@map("vanos")
}

// --- Catalogos ---

model Actividad {
  id           Int     @id @default(autoincrement()) @map("id_actividad")
  nombre       String  @unique @db.VarChar(100)
  unidadMedida String  @map("unidad_medida") @db.VarChar(20)
  descripcion  String? @db.VarChar(255)
  activo       Boolean @default(true)

  /// El precio no va en la actividad: depende del trabajador (TrabajadorActividad).
  metas     Meta[]
  registros RegistroEjecucion[]
  tarifas   TrabajadorActividad[]
  tareas    Tarea[]
  lineasLiquidacion LiquidacionLinea[]

  @@map("actividades")
}

model Cargo {
  id          Int     @id @default(autoincrement()) @map("id_cargo")
  nombre      String  @unique @db.VarChar(80)
  descripcion String? @db.VarChar(255)

  trabajadores Trabajador[]
  metas        Meta[]

  @@map("cargos")
}

// --- Personal de obra ---

/// Persona que trabaja en la obra. No necesita cuenta en el sistema.
model Trabajador {
  id        Int      @id @default(autoincrement()) @map("id_trabajador")
  documento String?  @unique @db.VarChar(30)
  nombre    String   @db.VarChar(100)
  apellido  String   @db.VarChar(100)
  cargoId   Int      @map("id_cargo")
  activo    Boolean  @default(true) @map("estado")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cargo        Cargo                 @relation(fields: [cargoId], references: [id], onDelete: Restrict)
  asignaciones CuadrillaTrabajador[]
  registros    RegistroEjecucion[]
  tarifas      TrabajadorActividad[]
  tareas       Tarea[]
  liquidaciones Liquidacion[]

  @@index([cargoId])
  @@map("trabajadores")
}

/// Precio por unidad de UNA actividad para UN trabajador (el vigente).
/// Cada jornada guarda una copia, asi un cambio no altera lo ya registrado.
model TrabajadorActividad {
  id           Int     @id @default(autoincrement()) @map("id_trabajador_actividad")
  trabajadorId Int     @map("id_trabajador")
  actividadId  Int     @map("id_actividad")
  valorM2      Decimal @map("valor_m2") @db.Decimal(12, 2)

  trabajador Trabajador @relation(fields: [trabajadorId], references: [id], onDelete: Cascade)
  actividad  Actividad  @relation(fields: [actividadId], references: [id], onDelete: Cascade)

  /// Un solo precio por trabajador y actividad.
  @@unique([trabajadorId, actividadId])
  @@index([trabajadorId])
  @@index([actividadId])
  @@map("trabajador_actividad")
}

model Cuadrilla {
  id          Int     @id @default(autoincrement()) @map("id_cuadrilla")
  proyectoId  Int     @map("id_proyecto")
  nombre      String  @db.VarChar(100)
  descripcion String? @db.VarChar(255)
  activo      Boolean @default(true) @map("estado")

  proyecto    Proyecto              @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  integrantes CuadrillaTrabajador[]
  registros   RegistroEjecucion[]
  tareas      Tarea[]

  @@unique([proyectoId, nombre])
  @@index([proyectoId])
  @@map("cuadrillas")
}

/// Historial de asignaciones de trabajadores a cuadrillas.
/// Al cambiar de cuadrilla, la asignacion anterior se cierra (fechaFin, activo = false).
model CuadrillaTrabajador {
  id           Int       @id @default(autoincrement()) @map("id_cuadrilla_trabajador")
  cuadrillaId  Int       @map("id_cuadrilla")
  trabajadorId Int       @map("id_trabajador")
  fechaInicio  DateTime  @map("fecha_inicio") @db.Date
  fechaFin     DateTime? @map("fecha_fin") @db.Date
  activo       Boolean   @default(true)

  cuadrilla  Cuadrilla  @relation(fields: [cuadrillaId], references: [id], onDelete: Cascade)
  trabajador Trabajador @relation(fields: [trabajadorId], references: [id], onDelete: Cascade)

  @@index([cuadrillaId])
  @@index([trabajadorId])
  @@index([activo])
  @@map("cuadrilla_trabajador")
}

/// Meta por actividad, segun proyecto, cargo y vigencia.
model Meta {
  id                  Int       @id @default(autoincrement()) @map("id_meta")
  proyectoId          Int       @map("id_proyecto")
  actividadId         Int       @map("id_actividad")
  cargoId             Int?      @map("id_cargo")
  rendimientoObjetivo Decimal?  @map("rendimiento_objetivo") @db.Decimal(10, 2)
  m2Objetivo          Decimal?  @map("m2_objetivo") @db.Decimal(12, 2)
  vigenciaDesde       DateTime  @map("vigencia_desde") @db.Date
  vigenciaHasta       DateTime? @map("vigencia_hasta") @db.Date

  proyecto  Proyecto  @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  actividad Actividad @relation(fields: [actividadId], references: [id], onDelete: Restrict)
  cargo     Cargo?    @relation(fields: [cargoId], references: [id], onDelete: SetNull)

  @@index([proyectoId, actividadId])
  @@index([vigenciaDesde, vigenciaHasta])
  @@map("metas")
}

// --- Tareas asignadas ---

/// Trabajo encargado antes de ejecutarse. El registro que abre la obra copia
/// sus datos. Una tarea da lugar a una sola obra.
model Tarea {
  id             Int             @id @default(autoincrement()) @map("id_tarea")
  codigo         String          @unique @db.VarChar(30)
  elementoId       Int             @map("id_elemento")
  actividadId    Int             @map("id_actividad")
  /// A quien se asigna (opcional).
  cuadrillaId    Int?            @map("id_cuadrilla")
  trabajadorId   Int?            @map("id_trabajador")
  /// Meta diaria que hereda el registro.
  m2Meta         Decimal?        @map("m2_meta") @db.Decimal(12, 2)
  fechaInicioPlan DateTime?      @map("fecha_inicio_plan") @db.Date
  fechaFinPlan    DateTime?      @map("fecha_fin_plan") @db.Date
  estado         EstadoEjecucion @default(PENDIENTE)
  observaciones  String?         @db.Text
  usuarioAsignaId Int            @map("id_usuario_asigna")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  elemento        ElementoConstructivo @relation(fields: [elementoId], references: [id], onDelete: Restrict)
  actividad     Actividad     @relation(fields: [actividadId], references: [id], onDelete: Restrict)
  cuadrilla     Cuadrilla?    @relation(fields: [cuadrillaId], references: [id], onDelete: SetNull)
  trabajador    Trabajador?   @relation(fields: [trabajadorId], references: [id], onDelete: SetNull)
  usuarioAsigna Usuario       @relation("TareaAsignadaPor", fields: [usuarioAsignaId], references: [id], onDelete: Restrict)

  /// Obra que nacio de la tarea (maximo una).
  registro RegistroEjecucion?

  @@index([elementoId])
  @@index([actividadId])
  @@index([cuadrillaId])
  @@index([trabajadorId])
  @@index([estado])
  @@map("tareas")
}

// --- Registros de obra (tabla central) ---

/// Un dia de trabajo sobre un elemento.
/// El primer registro abre la obra y guarda las medidas; los siguientes son avances.
///   registroAnteriorId: el dia anterior (para navegar la cadena)
///   registroOrigenId:   el registro que abrio la obra (para los calculos)
model RegistroEjecucion {
  id                 Int      @id @default(autoincrement()) @map("id_ejecucion")
  codigoRegistro     String   @unique @map("codigo_registro") @db.VarChar(30)
  fechaEjecucion     DateTime @map("fecha_ejecucion") @db.Date
  elementoId           Int      @map("id_elemento")
  actividadId        Int      @map("id_actividad")
  cuadrillaId        Int      @map("id_cuadrilla")
  trabajadorId       Int?     @map("id_trabajador")
  usuarioRegistraId  Int      @map("id_usuario_registra")
  usuarioActualizaId Int?     @map("id_usuario_actualiza")

  /// Tarea de origen. Solo en la apertura; es unica.
  tareaId Int? @unique @map("id_tarea")

  /// Cadena de la obra.
  registroAnteriorId Int? @unique @map("id_registro_anterior")
  registroOrigenId   Int? @map("id_registro_origen")

  /// Numero de avance (SR1, SR2...). Null en la apertura.
  numeroAvance Int? @map("numero_avance")

  /// Medidas del elemento. Solo en la apertura.
  largo Decimal? @db.Decimal(10, 2)
  alto  Decimal? @db.Decimal(10, 2)

  /// Cantidad total de la obra en la unidad de su actividad (el 100%). Solo en la apertura.
  /// m2 = largo x alto, ml = largo; und, m3 y kg la escribe el residente.
  cantidadTotal Decimal? @map("cantidad_total") @db.Decimal(12, 2)

  /// Cantidad ejecutada ese dia.
  m2Ejecutados Decimal @map("m2_ejecutados") @db.Decimal(12, 2)

  horaInicio      DateTime @map("hora_inicio") @db.Time(0)
  horaFinal       DateTime @map("hora_final") @db.Time(0)
  tiempoRecesoMin Int      @default(0) @map("tiempo_receso_min")

  /// Meta del dia, copiada al guardar.
  m2Meta Decimal? @map("m2_meta") @db.Decimal(12, 2)

  /// Precio por unidad del trabajador, copiado al guardar.
  /// Pago de la jornada = m2_ejecutados * valor_m2.
  valorM2 Decimal? @map("valor_m2") @db.Decimal(12, 2)

  observaciones String? @db.Text

  /// Liquidacion en que se pago. Una jornada pagada no se edita ni se borra.
  liquidacionId Int? @map("id_liquidacion")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  liquidacion        Liquidacion?         @relation(fields: [liquidacionId], references: [id], onDelete: SetNull)
  elemento           ElementoConstructivo @relation(fields: [elementoId], references: [id], onDelete: Restrict)
  actividad        Actividad     @relation(fields: [actividadId], references: [id], onDelete: Restrict)
  cuadrilla        Cuadrilla     @relation(fields: [cuadrillaId], references: [id], onDelete: Restrict)
  /// Restrict: un trabajador con jornadas no se puede borrar (se desactiva).
  trabajador       Trabajador?   @relation(fields: [trabajadorId], references: [id], onDelete: Restrict)
  usuarioRegistra  Usuario       @relation("RegistroCreadoPor", fields: [usuarioRegistraId], references: [id], onDelete: Restrict)
  usuarioActualiza Usuario?      @relation("RegistroActualizadoPor", fields: [usuarioActualizaId], references: [id], onDelete: SetNull)

  /// Registro anterior de la obra.
  registroAnterior RegistroEjecucion? @relation("Continuacion", fields: [registroAnteriorId], references: [id], onDelete: Restrict)
  /// Registro siguiente (como maximo uno).
  continuacion     RegistroEjecucion? @relation("Continuacion")

  /// Registro que abrio la obra y sus avances.
  registroOrigen RegistroEjecucion?  @relation("Obra", fields: [registroOrigenId], references: [id], onDelete: Cascade)
  avances        RegistroEjecucion[] @relation("Obra")

  /// Tarea de origen. Si se borra la tarea, el registro se conserva.
  tarea Tarea? @relation(fields: [tareaId], references: [id], onDelete: SetNull)

  @@index([fechaEjecucion])
  @@index([elementoId])
  @@index([actividadId])
  @@index([cuadrillaId])
  @@index([trabajadorId])
  @@unique([registroOrigenId, numeroAvance])
  @@index([registroOrigenId])
  @@index([fechaEjecucion, actividadId])
  @@index([liquidacionId])
  @@map("registros_ejecucion")
}

// --- Liquidaciones ---

/// Pago a un trabajador por lo que ejecuto en un periodo.
/// Usa el precio copiado en cada jornada. Las jornadas pagadas quedan marcadas
/// con id_liquidacion para no pagarlas dos veces.
model Liquidacion {
  id            Int                @id @default(autoincrement()) @map("id_liquidacion")
  codigo        String             @unique @db.VarChar(30)
  trabajadorId  Int                @map("id_trabajador")
  tipoPeriodo   PeriodoLiquidacion @map("tipo_periodo")
  desde         DateTime           @db.Date
  hasta         DateTime           @db.Date
  total         Decimal            @db.Decimal(14, 2)
  /// Cuenta de deposito. El numero es obligatorio.
  banco         String?            @db.VarChar(80)
  tipoCuenta    String?            @map("tipo_cuenta") @db.VarChar(20)
  numeroCuenta  String             @map("numero_cuenta") @db.VarChar(40)
  observaciones String?            @db.Text
  /// Responsable: quien hizo la liquidacion.
  usuarioLiquidaId Int             @map("id_usuario_liquida")
  createdAt     DateTime           @default(now()) @map("created_at")

  trabajador     Trabajador         @relation(fields: [trabajadorId], references: [id], onDelete: Restrict)
  usuarioLiquida Usuario            @relation("LiquidacionHechaPor", fields: [usuarioLiquidaId], references: [id], onDelete: Restrict)
  lineas         LiquidacionLinea[]
  registros      RegistroEjecucion[]

  @@index([trabajadorId])
  @@index([desde, hasta])
  @@map("liquidaciones")
}

/// Renglon del pago: una actividad a un precio.
model LiquidacionLinea {
  id            Int     @id @default(autoincrement()) @map("id_liquidacion_linea")
  liquidacionId Int     @map("id_liquidacion")
  actividadId   Int     @map("id_actividad")
  /// Copia del nombre y la unidad de la actividad al pagar.
  actividadNombre String  @map("actividad_nombre") @db.VarChar(100)
  unidad        String  @db.VarChar(20)
  valorUnitario Decimal @map("valor_unitario") @db.Decimal(12, 2)
  cantidad      Decimal @db.Decimal(14, 2)
  jornadas      Int
  subtotal      Decimal @db.Decimal(14, 2)

  liquidacion Liquidacion @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)
  actividad   Actividad   @relation(fields: [actividadId], references: [id], onDelete: Restrict)

  @@index([liquidacionId])
  @@map("liquidacion_lineas")
}
