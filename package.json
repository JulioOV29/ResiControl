{
  "name": "resicontrol",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de Gestion y Analisis de Informacion de Obra",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:push": "prisma db push",
    "db:constraints": "node prisma/aplicar-constraints.js",
    "aplicar": "prisma generate && prisma db push && node prisma/aplicar-constraints.js",
    "db:studio": "prisma studio",
    "seed": "node scripts/seed.js",
    "setup": "prisma db push && node prisma/aplicar-constraints.js && node scripts/seed.js",
    "importar": "node scripts/importar-prototipo.js",
    "db:reset": "prisma db push --force-reset --accept-data-loss",
    "rehacer": "prisma db push --force-reset --accept-data-loss && node prisma/aplicar-constraints.js && node scripts/seed.js && node scripts/importar-prototipo.js",
    "refechar": "node scripts/refechar.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "next-auth": "4.24.15",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.0",
    "dotenv": "17.2.4",
    "postcss": "8.5.28",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
}
